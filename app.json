{
  "expo": {
    "name": "GESA UMaT",
    "slug": "gesa-umat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gesa-logo.jpg",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/gesa-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#07050f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gesa.umat"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/gesa-logo.jpg",
        "backgroundColor": "#07050f"
      },
      "package": "com.gesa.umat",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "aa0726ce-a058-4583-ab26-dd4fb2fa7b89"
      }
    },
    "owner": "meruem999"
  }
}
