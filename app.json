{
  "expo": {
    "name": "GESA UMaT",
    "slug": "gesa-umat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/gesa-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#07050f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gesa.umat",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07050f"
      },
      "package": "com.gesa.umat",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#7c3aed"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GESA UMaT needs access to your photos so admins can upload pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-file-system"
    ],
    "extra": {
      "eas": {
        "projectId": "aa0726ce-a058-4583-ab26-dd4fb2fa7b89"
      }
    },
    "owner": "meruem999"
  }
}
